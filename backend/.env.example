# ── Scentrix Backend Environment ───────────────────────────────────────────
# Copy this file to .env in the backend/ directory for local (non-Docker)
# development. Docker-based setup also does not need this file: docker-compose.yml
# sets the backend environment, and config.py ships dev defaults for secrets
# Docker does not set (e.g. DATA_ENCRYPTION_KEY).
#
# Usage (non-Docker only):
#   cp backend/.env.example backend/.env
#   pip install -e ".[dev,runtime]"
#   uvicorn app.main:app --reload

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://Scentrix:Scentrix_password@localhost:5432/Scentrix

# ── Neo4j ──────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Vector Store (Pinecone) ────────────────────────────────────────────────
# Leave empty to use the local NumPy embedding fallback.
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-west4-gcp
PINECONE_INDEX_NAME=Scentrix-fragrances

# ── Authentication ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-change-in-production
# Dev-only default Fernet key (matches app/config.py). Rotate for any real deployment.
DATA_ENCRYPTION_KEY=d3_q8YEDiZl7fWE8-_EOeahljkGdp1Kdgwad6AHzMiA=

# ── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Feature Flags ──────────────────────────────────────────────────────────
ML_ENABLED=true
PHASE8_DISPATCHER_ENABLED=true
GENDER_NEUTRAL_RECOMMENDATIONS=true
USE_USER_VECTOR=true
