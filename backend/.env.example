# ── Scentrix Backend Environment ───────────────────────────────────────────
# Copy this file to .env in the backend/ directory for local development.
#
# Usage (non-Docker only):
#   cp backend/.env.example backend/.env
#   pip install -e ".[dev]"
#   uvicorn app.main:app --reload
#
# The app reads these from the environment. In a container or a PaaS deploy
# you set them as environment variables instead - no .env file is needed.

# ── Database ───────────────────────────────────────────────────────────────
# The app uses a SYNC SQLAlchemy engine, so the driver in the URL must match:
#   postgresql://  -> psycopg2 (installed by default)
#   postgresql+asyncpg://  -> async driver, NOT supported by a sync engine.
#
# Local development (default, creates backend/scentrix.db):
DATABASE_URL=sqlite:///./scentrix.db

# Production on a free tier - Neon's pooled connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Throwaway container with no database at all (writable, ephemeral, wiped on
# every restart - fine because the product flow stores nothing):
# DATABASE_URL=sqlite:////tmp/scentrix.db

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API. The
# deployed frontend origin MUST be listed here or every request is blocked.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Authentication (legacy, optional) ──────────────────────────────────────
# Only the retired /users/* and rating endpoints use this. The product flow
# is anonymous and never sends a token, so the app starts without it.
# JWT_SECRET_KEY=dev-secret-change-in-production

# ── Frontend ───────────────────────────────────────────────────────────────
# The frontend reads NEXT_PUBLIC_API_URL at BUILD time (it is inlined into the
# bundle by Next.js). Set it in the frontend's build environment, not here.
# NEXT_PUBLIC_API_URL=http://localhost:8000
