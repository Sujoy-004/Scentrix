# ── Scentrix Root Environment ──────────────────────────────────────────────
# Copy this file to .env and adjust values as needed.
# For Docker-based development, most variables have safe defaults in
# docker-compose.yml — you can start with an empty .env and only override
# values you need to change.
#
# Usage:
#   cp .env.example .env
#   docker compose up

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Credentials for the Postgres 15 container (defaults: Scentrix / Scentrix_password)
# DB_USER=Scentrix
# DB_PASSWORD=Scentrix_password
# DB_NAME=Scentrix

# ── Neo4j ──────────────────────────────────────────────────────────────────
# Credentials for the Neo4j 5 container (default: neo4j / neo4j_password)
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=neo4j_password

# ── JWT Authentication ─────────────────────────────────────────────────────
# Secret key for signing JWT tokens. Generate one with:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-secret

# ── Feature Flags ──────────────────────────────────────────────────────────
# PHASE8_DISPATCHER_ENABLED=true
# USE_USER_VECTOR=true

# ── Optional: Override Docker-internal connection strings ──────────────────
# The defaults point at the container service names; you only need these
# if your setup differs from the canonical docker-compose.yml.
# DOCKER_DATABASE_URL=postgresql+asyncpg://Scentrix:Scentrix_password@postgres:5432/Scentrix
# DOCKER_NEO4J_URI=neo4j://neo4j:7687
# DOCKER_REDIS_URL=redis://redis:6379/0

# ── Optional: Pinecone (leave empty for local NumPy fallback) ──────────────
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# PINECONE_GRAPH_INDEX_NAME=

# ── Optional: Sentry / Error Tracking ──────────────────────────────────────
# SENTRY_DSN=

# ── Optional: Cloudflare R2 (for data backups) ─────────────────────────────
# CLOUDFLARE_R2_ACCESS_KEY=
# CLOUDFLARE_R2_SECRET_KEY=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_ENDPOINT=

# ── Optional: External API Keys ────────────────────────────────────────────
# MISTRAL_API_KEY=
