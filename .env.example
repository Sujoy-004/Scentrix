# ═══════════════════════════════════════════════════════════════════════════════
# Scentrix — Deployment Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and adjust values.
# Required variables must be set. Optional ones can be left commented out.
#
#   cp .env.example .env

# ── Core (Required) ──────────────────────────────────────────────────────────
# PostgreSQL connection string (async driver).
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://Scentrix:password@localhost:5432/Scentrix

# Secret key for signing JWT tokens. Generate with:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-secret

# Encryption key for PII data. Generate with:
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=change-me-to-a-random-encryption-key

# ── CORS (Required for production) ───────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# For production, set to your frontend domain(s):
#   ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
# Default: http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS=http://localhost:3000

# ── Redis (Optional — caching, rate limiting) ────────────────────────────────
# Default: redis://localhost:6379/0
# Free-tier options: Upstash (100 MB), Redis Cloud (30 MB), or self-hosted.
# REDIS_URL=redis://localhost:6379/0

# ── Neo4j (Optional — graph-based recommendations) ───────────────────────────
# The backend falls back to the local JSON catalog if Neo4j is unavailable.
# Free-tier: Neo4j AuraDB free (500 MB), or self-hosted via Docker.
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password

# ── Pinecone (Optional — vector search, falls back to NumPy) ─────────────────
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=Scentrix-fragrances

# ── Feature Flags ────────────────────────────────────────────────────────────
# ML_ENABLED=false               # Enable GraphSAGE embedding cache
# PHASE8_DISPATCHER_ENABLED=true # Enable the Phase 8 dispatcher logic
# USE_USER_VECTOR=true           # Use user vector for recommendations

# ── Optional Services ────────────────────────────────────────────────────────
# SENTRY_DSN=                    # Error tracking (free tier available)
# GOOGLE_API_KEY=                # Gemini API key (Digital Sommelier)
# MISTRAL_API_KEY=               # Mistral AI API key (optional)
