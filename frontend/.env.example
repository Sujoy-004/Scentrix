# ── Scentrix Frontend Environment ──────────────────────────────────────────
# Copy this file to .env.local in the frontend/ directory.
# Inside Docker containers these values are set by docker-compose.yml.
#
# Usage:
#   cp frontend/.env.example frontend/.env.local

# Backend API URL (used by the browser at runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostHog analytics (optional — leave empty to disable)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
